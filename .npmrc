# React Native and Expo resolve native modules, Babel plugins and Metro's
# transformer graph by walking node_modules from wherever a package physically
# sits. pnpm's default isolated layout puts every package under .pnpm/<name>@<ver>,
# so Babel — which resolves plugins relative to @babel/core's own location, not
# relative to the preset that asked for them — cannot see them: the release
# bundle failed on babel-preset-expo, then on @babel/plugin-transform-react-jsx,
# and would have continued through the whole plugin graph.
#
# Hoisted linking is what Expo documents for pnpm monorepos. It costs the strict
# dependency isolation pnpm gives by default; declared dependencies are still
# the source of truth in each package.json.
node-linker=hoisted
